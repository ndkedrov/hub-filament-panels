{
    "name": "ndkedrov/hub-filament-panels",
    "description": "A collection of full-stack components for accelerated Laravel app development.",
    "license": "MIT",
    "homepage": "https://github.com/filamentphp/filament",
    "support": {
        "issues": "https://github.com/filamentphp/filament/issues",
        "source": "https://github.com/filamentphp/filament"
    },
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.1",
        "chillerlan/php-qrcode": "^5.0|^6.0",
        "ndkedrov/hub-filament-actions": "5.11.1.1",
        "filament/forms": "5.11.1",
        "filament/infolists": "5.11.1",
        "filament/notifications": "5.11.1",
        "filament/schemas": "5.11.1",
        "filament/support": "5.11.1",
        "filament/tables": "5.11.1",
        "filament/widgets": "5.11.1",
        "pragmarx/google2fa": "^8.0|^9.0",
        "pragmarx/google2fa-qrcode": "^3.0|^4.0"
    },
    "replace": {
        "filament/filament": "5.11.1"
    },
    "autoload": {
        "files": [
            "src/global_helpers.php",
            "src/helpers.php"
        ],
        "psr-4": {
            "Filament\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filament\\FilamentServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
